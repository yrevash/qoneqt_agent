# Database Configuration
DB_USER=qoneqt_user
DB_PASSWORD=changeme_strong_password
DB_HOST=db
DB_PORT=5432
DB_NAME=qoneqt_db

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_USER=qoneqt
RABBITMQ_PASSWORD=changeme_rabbitmq_password

# Ollama LLM Configuration
# For GPU server: Use host Ollama at http://host.docker.internal:11434
# Or run Ollama in Docker with GPU support
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# Security - CRITICAL: Change this to a random string!
# Generate with: openssl rand -hex 32
SECRET_KEY=changeme_generate_random_secret_key_with_openssl

# SMTP Configuration for Alertmanager
SMTP_HOST=smtp.gmail.com:587
SMTP_FROM=your_email@gmail.com
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here

# API Configuration
API_V1_STR=/api/v1
PROJECT_NAME=Qoneqt Agent Network

# Frontend Configuration
NEXT_PUBLIC_API_URL=https://1g3x36j2-8080.inc1.devtunnels.ms/
